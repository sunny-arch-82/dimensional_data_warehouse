# Local PostgreSQL warehouse (demo-only credentials)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=analytics
POSTGRES_USER=analytics
POSTGRES_PASSWORD=analytics_local_only

# Dagster
DAGSTER_HOME=/opt/dagster/dagster_home
DBT_PROFILES_DIR=/opt/dagster/app/dbt_project

# Cube semantic API
CUBE_API_SECRET=local_dev_cube_secret_change_me
CUBE_API_URL=http://cube:4000

# Cube SQL API - this is the endpoint Metabase uses
CUBE_SQL_HOST=cube
CUBE_SQL_PORT=15432
CUBE_SQL_DATABASE=cube
CUBE_SQL_USER=analytics_bi
CUBE_SQL_PASSWORD=analytics_bi_local_only

# Reconciliation
METRIC_RECONCILIATION_TOLERANCE=0.01
